# Godot 4+ specific ignores
.godot/

# Godot-specific ignores
.import/
export.cfg
export_presets.cfg

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json

# DCC specific files
*.blend[0-9]*

*.*@*
*.gi
*.gi2

*_bak*.hip
*_bak*.hipnc

*.DS_Store

# godot-sqlite GDExtension: keep only Windows + Android binaries (our export
# targets). The iOS/macOS/Linux/web libs are large and unused here, and the
# two iOS godot-cpp files exceed GitHub's 100 MB limit. Re-download bin.zip
# from the godot-sqlite releases if another platform is needed later.
addons/godot-sqlite/bin/*ios*
addons/godot-sqlite/bin/*macos*
addons/godot-sqlite/bin/*linux*
addons/godot-sqlite/bin/*web*
# Godot editor hot-reload temp copies of the native lib (transient)
addons/godot-sqlite/bin/~*
*.TMP

# Subagent-driven-development scratch workspace (ledger, briefs, review packages)
.superpowers/
