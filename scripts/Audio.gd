extends Node
## Autoload ("Audio"). One-shot sound effects + looping background music.
## WAV files live in res://audio/ and are generated by tools/generate_audio.py.
## Everything is null-guarded, so the game still runs if a sound is missing.

var _players: Dictionary = {}
var _streams: Dictionary = {}
var _music: AudioStreamPlayer

func play(sfx: String, volume_db: float = 0.0) -> void:
	var stream = _get_stream(sfx)
	if stream == null:
		return
	var p: AudioStreamPlayer = _players.get(sfx)
	if p == null:
		p = AudioStreamPlayer.new()
		add_child(p)
		p.stream = stream
		_players[sfx] = p
	p.volume_db = volume_db
	p.play()

func play_music(track: String, volume_db: float = -14.0) -> void:
	var stream = _get_stream(track)
	if stream == null:
		return
	if stream is AudioStreamWAV:
		stream.loop_mode = AudioStreamWAV.LOOP_FORWARD
		stream.loop_begin = 0
		stream.loop_end = stream.data.size() / 2   # 16-bit mono -> bytes / 2 = frames
	if _music == null:
		_music = AudioStreamPlayer.new()
		add_child(_music)
	if _music.stream == stream and _music.playing:
		return   # already playing this track, don't restart
	_music.stream = stream
	_music.volume_db = volume_db
	_music.play()

func stop_music() -> void:
	if _music != null:
		_music.stop()

func _exit_tree() -> void:
	# Stop music on shutdown. (Headless --quit-after may still log a benign
	# "resource still in use" notice for the cached audio sample; that does not
	# happen on a normal window close and does not affect the running game.)
	stop_music()

func _get_stream(name: String):
	if _streams.has(name):
		return _streams[name]
	var path := "res://audio/%s.wav" % name
	var s = null
	if ResourceLoader.exists(path):
		s = load(path)
	_streams[name] = s
	return s
