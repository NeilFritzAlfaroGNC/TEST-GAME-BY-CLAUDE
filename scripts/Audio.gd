extends Node
## Autoload ("Audio"). One-shot sound effects + looping background music.
## WAV files live in res://audio/ and are generated by tools/generate_audio.py.
## Everything is null-guarded, so the game still runs if a sound is missing.
## MainMenu and gameplay scripts call this autoload by sound name; the mute
## state is persisted through DB's generic settings table.

# Voices per SFX: rapid repeats (e.g. two quick "correct"s) overlap instead
# of cutting each other off; past the cap the oldest voice is reused.
const MAX_VOICES_PER_SFX := 4

var _players: Dictionary = {}   # sfx name -> Array of AudioStreamPlayer (voice pool)
var _streams: Dictionary = {}
var _music: AudioStreamPlayer
var muted: bool = false

func _ready() -> void:
	# Keep audio alive while the tree is paused (pause menu): music keeps
	# playing and the menu's click sounds stay audible.
	process_mode = Node.PROCESS_MODE_ALWAYS
	# Restore the persisted mute setting (the DB autoload loads before Audio).
	muted = DB.get_setting_int("muted", 0) == 1
	AudioServer.set_bus_mute(0, muted)

func set_muted(m: bool) -> void:
	muted = m
	AudioServer.set_bus_mute(0, m)
	DB.set_setting_int("muted", 1 if m else 0)

func toggle_muted() -> void:
	set_muted(not muted)

func play(sfx: String, volume_db: float = 0.0) -> void:
	var stream = _get_stream(sfx)
	if stream == null:
		return
	if not _players.has(sfx):
		_players[sfx] = []
	var pool: Array = _players[sfx]
	var p: AudioStreamPlayer = null
	for cand in pool:
		if not cand.playing:
			p = cand
			break
	if p == null:
		if pool.size() >= MAX_VOICES_PER_SFX:
			p = pool[0]   # every voice busy: steal one
		else:
			p = AudioStreamPlayer.new()
			add_child(p)
			p.stream = stream
			pool.append(p)
	p.volume_db = volume_db
	p.play()

func play_music(track: String, volume_db: float = -14.0) -> void:
	var stream = _get_stream(track)
	if stream == null:
		return
	if stream is AudioStreamWAV:
		stream.loop_mode = AudioStreamWAV.LOOP_FORWARD
		stream.loop_begin = 0
		stream.loop_end = stream.data.size() / 2   # 16-bit mono -> bytes / 2 = frames
	if _music == null:
		_music = AudioStreamPlayer.new()
		add_child(_music)
	if _music.stream == stream and _music.playing:
		return   # already playing this track, don't restart
	_music.stream = stream
	_music.volume_db = volume_db
	_music.play()

func stop_music() -> void:
	if _music != null:
		_music.stop()

func _exit_tree() -> void:
	# Stop music on shutdown. (Headless --quit-after may still log a benign
	# "resource still in use" notice for the cached audio sample; that does not
	# happen on a normal window close and does not affect the running game.)
	stop_music()

func _get_stream(sound_name: String) -> AudioStream:
	if _streams.has(sound_name):
		return _streams[sound_name]
	var path := "res://audio/%s.wav" % sound_name
	var s: AudioStream = null
	if ResourceLoader.exists(path):
		var res: Resource = load(path)
		if res is AudioStream:
			s = res
	_streams[sound_name] = s
	return s
