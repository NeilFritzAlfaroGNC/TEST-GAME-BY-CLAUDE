speaker_name = "Burger Monster"
dialogue_line = "LOOK AT THEM RUN! THIS IS TOO EASY!"
metadata/_custom_type_script = "uid://cybnke0g05xtl"

[sub_resource type="Resource" id="Resource_8wps7"]
script = ExtResource("3_4ypkc")
speaker_name = "Soda Monster"
dialogue_line = "LET'S TURN THIS WHOLE SCHOOL UPSIDE DOWN!"
metadata/_custom_type_script = "uid://cybnke0g05xtl"

[sub_resource type="Resource" id="Resource_vt5gv"]
script = ExtResource("3_4ypkc")
speaker_name = "Student 1"
dialogue_line = "SOMEONE! PLEASE HELP US!"
metadata/_custom_type_script = "uid://cybnke0g05xtl"

[sub_resource type="Resource" id="Resource_ms4jw"]
script = ExtResource("3_4ypkc")
speaker_name = "Student 2"
dialogue_line = "THEY'RE EVERYWHERE! WHERE DID THEY COME FROM?!"
