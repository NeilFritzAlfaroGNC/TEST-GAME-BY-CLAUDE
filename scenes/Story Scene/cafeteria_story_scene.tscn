[sub_resource type="Resource" id="Resource_q481n"]
script = ExtResource("3_4ypkc")
speaker_name = "Burger Monster"
dialogue_line = "FINALLY! LUNCHTIME IS OVER! NOW IT'S YOUR TURN TO BE THE FOOD!"
metadata/_custom_type_script = "uid://cybnke0g05xtl"

[sub_resource type="Resource" id="Resource_equhl"]
script = ExtResource("3_4ypkc")
speaker_name = "Student 1"
dialogue_line = "WHAT IS HAPPENING TO THE FOOD?!"
metadata/_custom_type_script = "uid://cybnke0g05xtl"

[sub_resource type="Resource" id="Resource_gfyhm"]
script = ExtResource("3_4ypkc")
speaker_name = "Student 2"
dialogue_line = "THAT BURGER HAS TEETH! WHY DOES IT HAVE TEETH?!"
metadata/_custom_type_script = "uid://cybnke0g05xtl"

[sub_resource type="Resource" id="Resource_ob7cq"]
script = ExtResource("3_4ypkc")
speaker_name = "SFX"
dialogue_line = "BOING! CRASH! SCREEE!"
metadata/_custom_type_script = "uid://cybnke0g05xtl"

[sub_resource type="Resource" id="Resource_x82hw"]
