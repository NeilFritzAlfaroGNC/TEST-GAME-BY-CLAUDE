metadata/_custom_type_script = "uid://b485ccrv6aek7"

[sub_resource type="Resource" id="Resource_i6iok"]
script = ExtResource("3_4ypkc")
speaker_name = "Burger Monster"
dialogue_line = "GET BACK HERE!"
metadata/_custom_type_script = "uid://cybnke0g05xtl"

[sub_resource type="Resource" id="Resource_v7360"]
script = ExtResource("3_4ypkc")
speaker_name = "Hero"
dialogue_line = "Whoa! You almost turned me into a burger!"
metadata/_custom_type_script = "uid://cybnke0g05xtl"

[sub_resource type="Resource" id="Resource_vv1og"]
script = ExtResource("3_4ypkc")
speaker_name = "Soda Monster"
dialogue_line = "YOU CAN'T DODGE US FOREVER!"
metadata/_custom_type_script = "uid://cybnke0g05xtl"

[sub_resource type="Resource" id="Resource_hcfhk"]
script = ExtResource("3_4ypkc")
speaker_name = "Hero"
dialogue_line = "Yeah... I'm starting to notice that!"
metadata/_custom_type_script = "uid://cybnke0g05xtl"

[sub_resource type="Resource" id="Resource_irv7a"]
script = ExtResource("3_4ypkc")
speaker_name = "Narrator"
dialogue_line = "The hero backs away as more monsters approach."
metadata/_custom_type_script = "uid://cybnke0g05xtl"

[sub_resource type="Resource" id="Resource_un2a6"]
script = ExtResource("3_4ypkc")
speaker_name = "Hero"
dialogue_line = "Okay. A little help would be nice right about now!"
metadata/_custom_type_script = "uid://cybnke0g05xtl"

[sub_resource type="Resource" id="Resource_q0skw"]
script = ExtResource("2_bwaa1")
story_image = ExtResource("7_x82hw")
dialogues = Array[ExtResource("3_4ypkc")]([SubResource("Resource_i6iok"), SubResource("Resource_v7360"), SubResource("Resource_vv1og"), SubResource("Resource_hcfhk"), SubResource("Resource_irv7a"), SubResource("Resource_un2a6")])
metadata/_custom_type_script = "uid://b485ccrv6aek7"

[sub_resource type="Resource" id="Resource_clb8i"]
script = ExtResource("3_4ypkc")
speaker_name = "Device"
dialogue_line = "RING! RING!"
metadata/_custom_type_script = "uid://cybnke0g05xtl"

[sub_resource type="Resource" id="Resource_2e0sc"]
script = ExtResource("3_4ypkc")
speaker_name = "Hero"
dialogue_line = "Now? Seriously?!"
metadata/_custom_type_script = "uid://cybnke0g05xtl"

[sub_resource type="Resource" id="Resource_x2yqu"]
script = ExtResource("3_4ypkc")
speaker_name = "Professor"
dialogue_line = "Can you hear me? My experiment has gone terribly wrong!"
metadata/_custom_type_script = "uid://cybnke0g05xtl"

[sub_resource type="Resource" id="Resource_sk7k5"]
script = ExtResource("3_4ypkc")
speaker_name = "Hero"
dialogue_line = "You mean these walking lunch disasters are YOUR fault?!"
metadata/_custom_type_script = "uid://cybnke0g05xtl"

[sub_resource type="Resource" id="Resource_hhdul"]
script = ExtResource("3_4ypkc")
speaker_name = "Professor"
dialogue_line = "Technically... yes"
metadata/_custom_type_script = "uid://cybnke0g05xtl"

[sub_resource type="Resource" id="Resource_vqxfh"]
script = ExtResource("3_4ypkc")
speaker_name = "Hero"
dialogue_line = "TECHNICALLY?!"
metadata/_custom_type_script = "uid://cybnke0g05xtl"

[sub_resource type="Resource" id="Resource_j8d4s"]
script = ExtResource("3_4ypkc")
speaker_name = "Professor"
dialogue_line = "Listen! The monsters can be stopped. You need to choose the correct healthy foods!"
metadata/_custom_type_script = "uid://cybnke0g05xtl"

[sub_resource type="Resource" id="Resource_tj3fh"]
script = ExtResource("3_4ypkc")
speaker_name = "Hero"
dialogue_line = "Great. My survival depends on knowing my lunch."
metadata/_custom_type_script = "uid://cybnke0g05xtl"

[sub_resource type="Resource" id="Resource_b62c8"]
script = ExtResource("2_bwaa1")
story_image = ExtResource("8_ob7cq")
dialogues = Array[ExtResource("3_4ypkc")]([SubResource("Resource_clb8i"), SubResource("Resource_2e0sc"), SubResource("Resource_x2yqu"), SubResource("Resource_sk7k5"), SubResource("Resource_hhdul"), SubResource("Resource_vqxfh"), SubResource("Resource_j8d4s"), SubResource("Resource_tj3fh")])
metadata/_custom_type_script = "uid://b485ccrv6aek7"

[sub_resource type="Resource" id="Resource_dugdo"]
script = ExtResource("3_4ypkc")
speaker_name = "Professor"
dialogue_line = "Choose the right healthy food! Each food group gives you a different power!"
metadata/_custom_type_script = "uid://cybnke0g05xtl"

[sub_resource type="Resource" id="Resource_ofqqb"]
script = ExtResource("3_4ypkc")
speaker_name = "Hero"
dialogue_line = "So my lunch is my weapon now?"
metadata/_custom_type_script = "uid://cybnke0g05xtl"

[sub_resource type="Resource" id="Resource_e4yxn"]
script = ExtResource("3_4ypkc")
speaker_name = "Professor"
dialogue_line = "Exactly! Go foods give you energy, Grow foods help build your body, and Glow foods help keep you healthy!"
metadata/_custom_type_script = "uid://cybnke0g05xtl"

[sub_resource type="Resource" id="Resource_qrhpj"]
script = ExtResource("3_4ypkc")
speaker_name = "Burger Monster"
dialogue_line = "Stop talking and fight us!"
metadata/_custom_type_script = "uid://cybnke0g05xtl"

[sub_resource type="Resource" id="Resource_d4qup"]
script = ExtResource("3_4ypkc")
speaker_name = "Hero"
dialogue_line = "Fine! Let's see what today's lunch can do!"
metadata/_custom_type_script = "uid://cybnke0g05xtl"

[sub_resource type="Resource" id="Resource_tkkb8"]
script = ExtResource("2_bwaa1")
story_image = ExtResource("9_ckoi3")
