metadata/_custom_type_script = "uid://b485ccrv6aek7"

[sub_resource type="Resource" id="Resource_vqcon"]
script = ExtResource("3_4ypkc")
speaker_name = "Burger Monster"
dialogue_line = "Come on, hero! Show me what you've got!"
metadata/_custom_type_script = "uid://cybnke0g05xtl"

[sub_resource type="Resource" id="Resource_h5wka"]
script = ExtResource("3_4ypkc")
speaker_name = "Hero"
dialogue_line = "All right! Time to serve up some justice!"
metadata/_custom_type_script = "uid://cybnke0g05xtl"

[sub_resource type="Resource" id="Resource_53qo3"]
script = ExtResource("3_4ypkc")
speaker_name = "Professor (through the communication device)"
dialogue_line = "Wait! Before you attack, let me show you how to use your food powers!"
metadata/_custom_type_script = "uid://cybnke0g05xtl"

[sub_resource type="Resource" id="Resource_eblcd"]
script = ExtResource("3_4ypkc")
speaker_name = "Hero"
dialogue_line = "A tutorial? Now?!"
metadata/_custom_type_script = "uid://cybnke0g05xtl"

[sub_resource type="Resource" id="Resource_kavyl"]
script = ExtResource("3_4ypkc")
speaker_name = "Professor"
dialogue_line = "Trust me. You'll need it!"
