[sub_resource type="Resource" id="Resource_hqbc3"]
script = ExtResource("3_4ypkc")
speaker_name = "Hero"
dialogue_line = "Don't worry. I've dealt with things like these before."
metadata/_custom_type_script = "uid://cybnke0g05xtl"

[sub_resource type="Resource" id="Resource_nyaov"]
script = ExtResource("3_4ypkc")
speaker_name = "Student 1"
dialogue_line = "THINGS LIKE THESE?!"
metadata/_custom_type_script = "uid://cybnke0g05xtl"

[sub_resource type="Resource" id="Resource_j6y7i"]
script = ExtResource("3_4ypkc")
speaker_name = "Hero"
dialogue_line = "Long story. Stay behind me."
metadata/_custom_type_script = "uid://cybnke0g05xtl"

[sub_resource type="Resource" id="Resource_0mppn"]
script = ExtResource("3_4ypkc")
speaker_name = "Burger Monster"
dialogue_line = "WHO DO YOU THINK YOU ARE?!"
metadata/_custom_type_script = "uid://cybnke0g05xtl"

[sub_resource type="Resource" id="Resource_2pigk"]
script = ExtResource("3_4ypkc")
speaker_name = "Hero"
dialogue_line = "The person who's about to ruin your lunch break."
metadata/_custom_type_script = "uid://cybnke0g05xtl"

[sub_resource type="Resource" id="Resource_gpkvk"]
script = ExtResource("3_4ypkc")
speaker_name = "SFX"
dialogue_line = "DUN-DUN-DUUUN!"
metadata/_custom_type_script = "uid://cybnke0g05xtl"

[sub_resource type="Resource" id="Resource_vd2hn"]
