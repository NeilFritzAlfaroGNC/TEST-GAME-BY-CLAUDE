[sub_resource type="Resource" id="Resource_rdfds"]
script = ExtResource("3_4ypkc")
speaker_name = "Student 1"
dialogue_line = "Uh... guys? Is my lunch supposed to be moving?"
metadata/_custom_type_script = "uid://cybnke0g05xtl"

[sub_resource type="Resource" id="Resource_xgcg4"]
script = ExtResource("3_4ypkc")
speaker_name = "Student 2"
dialogue_line = "Stop messing around and eat."
metadata/_custom_type_script = "uid://cybnke0g05xtl"

[sub_resource type="Resource" id="Resource_q0o1k"]
script = ExtResource("3_4ypkc")
speaker_name = "Narrator"
dialogue_line = "The hamburger suddenly twitches again."
metadata/_custom_type_script = "uid://cybnke0g05xtl"

[sub_resource type="Resource" id="Resource_50pn7"]
script = ExtResource("3_4ypkc")
speaker_name = "Student 1"
dialogue_line = "Wait... IT MOVED AGAIN!"
metadata/_custom_type_script = "uid://cybnke0g05xtl"

[sub_resource type="Resource" id="Resource_nogtf"]
