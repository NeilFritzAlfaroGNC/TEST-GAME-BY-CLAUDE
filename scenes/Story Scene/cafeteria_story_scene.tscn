[sub_resource type="Resource" id="Resource_bwaa1"]
script = ExtResource("3_4ypkc")
speaker_name = "Narrator"
dialogue_line = "It was just another normal day at school. Nothing unusual. Nothing dangerous. And definitely nothing that could possibly go wrong"
metadata/_custom_type_script = "uid://cybnke0g05xtl"

